.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# VS Code
.vscode/

.env
.env.*

# Secrets — never commit these. (google-services.json / GoogleService-Info.plist
# are client config and ARE tracked on purpose; the sending credential is the
# service-account JSON below, which lives only in Supabase secrets.)
*-firebase-adminsdk-*.json
service-account*.json
serviceAccount*.json
# Apple push / signing keys
*.p8
AuthKey_*.p8
*.p12
*.mobileprovision

# Flutter metadata
.metadata
.flutter-plugins

# Claude Code memory (local AI assistant state)
.claude/

# Desktop admin console (local-only tool; not part of the app build)
desktop_admin/
android/upload-keystore.jks
*.jks
*.keystore

# Local-only Supabase demo/scratch (not part of the app build)
supabase/demo/

# Ranking Lab (tools/ranking_simulation) — SOURCE is tracked, run output is not.
# These are regenerated by `dart run tools/ranking_simulation/runner.dart` and
# `ui/build.dart`; together they are ~7MB of blobs that would land in every clone.
# results/ranking_lab.html IS tracked on purpose — it is the published artifact.
tools/ranking_simulation/results/report.pdf
tools/ranking_simulation/results/report.html
tools/ranking_simulation/results/*.json
tools/ranking_simulation/ui/lab_kernel.js
tools/ranking_simulation/ui/lab_kernel.js.deps
tools/ranking_simulation/ui/lab_kernel.js.map
