<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ (API 33): without this, requestPermission() can never grant
         and the OS silently drops every push. Required for any notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Buzz the phone when a push lands while the app is in the foreground
         (HapticFeedback.vibrate in push_router.dart) — otherwise the toast is
         silent and easy to miss. -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <application
        android:label="Padel Rivals"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Catches the padelclay:// redirect at the end of Google sign-in.
             iOS needs nothing here because ASWebAuthenticationSession watches
             for the scheme itself; on Android the Chrome Custom Tab hands the
             URL to the system, so without this filter NOTHING claims it and the
             tab just hangs after you pick an account. flutter_web_auth_2 does
             not declare this activity itself — the app has to (see its README).
             taskAffinity="" mirrors MainActivity above so the callback returns
             into the same task instead of spawning a second one; keep the two
             in sync (the empty affinity is Flutter's own template default and
             blocks task-affinity hijacking, so don't just drop it). -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="padelclay"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- FCM: when a notification arrives while the app is backgrounded/killed,
             the system tray builds it on THIS channel. It must be a real channel
             created by the app (see MainActivity.kt) — on Android 8+ an unknown
             channel means the notification is dropped. High importance = heads-up
             pop-up + lock-screen visibility. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="padel_default" />
        <!-- White silhouette shown in the status bar / lock screen, tinted with
             the brand color. Without these, FCM falls back to the launcher icon
             (often a colored square). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
